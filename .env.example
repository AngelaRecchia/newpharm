# Storyblok Configuration
# Get these from: https://app.storyblok.com

# CDN Token (Public Token from Storyblok Settings > Access Tokens)
NEXT_PUBLIC_STORYBLOK_ACCESS_TOKEN=your_cdn_token_here

# Space ID (from Storyblok Settings > General)
NEXT_PUBLIC_STORYBLOK_SPACE_ID=your_space_id_here

# Management Token (from https://app.storyblok.com/#/me/account)
# Required for fetching locales and generating types
STORYBLOK_MANAGEMENT_TOKEN=your_management_token_here

# Google reCAPTCHA v2 (modale download cataloghi)
# https://www.google.com/recaptcha/admin — tipo "Casella di controllo"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Storage PDF schede tecniche (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2...)
# Se non configurato, i PDF sono serviti con cache in-memory (solo dev).
# Endpoint es: R2 https://<account>.r2.cloudflarestorage.com
PDF_STORAGE_ENDPOINT=
PDF_STORAGE_REGION=auto
PDF_STORAGE_ACCESS_KEY_ID=
PDF_STORAGE_SECRET_ACCESS_KEY=
PDF_STORAGE_BUCKET=

# Meilisearch Cloud (search)
# Host es: https://<project-id>.meilisearch.io
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_NAME=newpharm_search
