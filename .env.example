# Storyblok Configuration
# Get these from: https://app.storyblok.com

# CDN token — server only (Public in prod, Preview in draft/local).
# Do not prefix with NEXT_PUBLIC_: it would ship in the JS bundle.
STORYBLOK_ACCESS_TOKEN=your_cdn_token_here

# Space ID (from Storyblok Settings > General)
NEXT_PUBLIC_STORYBLOK_SPACE_ID=your_space_id_here

# draft = Visual Editor + unpublished content (local / Vercel preview)
# published = production ISR
NEXT_PUBLIC_STORYBLOK_VERSION=draft

# Management Token (from https://app.storyblok.com/#/me/account)
# Required for fetching locales and generating types
STORYBLOK_MANAGEMENT_TOKEN=your_management_token_here

# Google reCAPTCHA v2 (modale download cataloghi)
# https://www.google.com/recaptcha/admin — tipo "Casella di controllo"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Form contatti (Resend) — in dev senza dominio: onboarding@resend.dev → solo la tua email Resend
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=info@newpharm.it

# Newsletter Brevo (solo se l'utente spunta il consenso) — opzionale finché manca la lista
# https://app.brevo.com → SMTP & API + Contacts → Lists (ID numerico in URL)
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=

# Storage PDF schede tecniche (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2...)
# Opzionale. Senza queste variabili la scheda è generata e scaricata on-demand, senza cache.
# Endpoint es: R2 https://<account>.r2.cloudflarestorage.com
PDF_STORAGE_ENDPOINT=
PDF_STORAGE_REGION=auto
PDF_STORAGE_ACCESS_KEY_ID=
PDF_STORAGE_SECRET_ACCESS_KEY=
PDF_STORAGE_BUCKET=

# Algolia (search)
# https://dashboard.algolia.com/account/api-keys
ALGOLIA_APP_ID=
# Admin key: needed for indexing script and Storyblok webhook updates
ALGOLIA_ADMIN_API_KEY=
# Search-only key: used by /api/search
ALGOLIA_SEARCH_API_KEY=
# Base name used as suffix for the index.
# draft     → test_<ALGOLIA_INDEX_NAME>
# published → prod_<ALGOLIA_INDEX_NAME>
ALGOLIA_INDEX_NAME=SEARCH
